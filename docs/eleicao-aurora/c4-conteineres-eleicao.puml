@startuml c4-conteineres-eleicao
!include <C4/C4_Container>
skinparam dpi 150
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Contêineres (C4 Nível 2) — Eleição de Aurora em dois turnos

Person(eleitor, "Eleitor", "Vota na cabine do seu local")
Person(mesario, "Mesários", "Identificam o eleitor e liberam o voto (dupla)")
Person(fiscal, "Fiscais de candidaturas", "Acompanham abertura, votação e fechamento")
Person(comissao, "Comissão Eleitoral", "Cadastra eleição, aprova versão e apura")
Person(ti, "Equipe de TI / Operação", "Desenvolve, publica e opera a nuvem")
Person(auditor, "Auditoria independente", "Confere código, boletins e logs")

System_Ext(cadastro, "Cadastro de Eleitores", "Base oficial (fonte dos eleitores aptos)")
System_Ext(github, "GitHub + GitHub Actions", "Código revisado (2 aprovações), testes e build")
System_Ext(publico, "Imprensa e população", "Consulta os resultados publicados")

System_Boundary(local, "Local de votação (×150) — funciona sem internet") {
  Container(estacao, "Estação do Mesário", "React (microfrontend)", "Confere o eleitor, marca 'já votou' e libera um token de uso único")
  Container(cabine, "Cabine de Votação", "React (microfrontend, offline)", "Mostra as candidaturas; valida o token e registra o voto sem identidade")
  Container(servLocal, "Servidor Local", "Node.js 22 em Docker", "Valida o hash do software, emite zerésima e Boletim de Urna (BU), sincroniza com a nuvem")
  ContainerDb(dbEleitores, "Eleitores do local", "MongoDB local", "Só os eleitores deste local + marca 'já votou' (sem escolha)")
  ContainerDb(dbUrna, "Urna de votos", "MongoDB local", "Votos anônimos, embaralhados, sem eleitor e sem horário exato")
  ContainerQueue(filaLocal, "Fila de sincronização", "Azurite / Queue Storage local", "Guarda BU e logs até a conexão voltar")
}

System_Boundary(nuvem, "Nuvem — Azure") {
  Container(portal, "Portal de Apuração e Resultados", "Azure Static Web Apps (shell + microfrontends)", "Painel da Comissão, da auditoria e resultado público")
  Container(gateway, "API Gateway", "Azure Function", "Única entrada: rotas, CORS, rate limit e correlation-id")
  Container(svcEleicao, "Serviço de Eleição", "Azure Functions", "Candidaturas, turnos (1º/2º), locais e carga de eleitores por local")
  Container(svcApuracao, "Serviço de Apuração", "Azure Functions", "Recebe BU, soma votos, calcula >50% e as 2 mais votadas")
  ContainerQueue(filaBU, "Fila boletins-de-urna", "Azure Queue Storage", "BU e logs vindos dos locais")
  ContainerDb(dbEleicao, "pjbl_eleicao", "MongoDB Atlas", "Eleição, candidaturas, turnos")
  ContainerDb(dbApuracao, "pjbl_apuracao", "MongoDB Atlas", "BUs e totais por turno")
  ContainerDb(logs, "Registro de auditoria", "Blob Storage imutável (WORM)", "Logs encadeados por hash; ninguém edita ou apaga")
  Container(registro, "Registro de imagens + Key Vault", "Container Registry + Key Vault", "Imagem do Servidor Local assinada e seu hash (SHA-256)")
}

Rel(eleitor, estacao, "Apresenta documento a")
Rel(mesario, estacao, "Opera")
Rel(eleitor, cabine, "Vota com o token")
Rel(fiscal, estacao, "Acompanha abertura e fechamento")
Rel(estacao, servLocal, "Consulta eleitor / pede token", "HTTP (rede local)")
Rel(cabine, servLocal, "Envia voto + token", "HTTP (rede local)")
Rel(servLocal, dbEleitores, "Lê e marca 'já votou'")
Rel(servLocal, dbUrna, "Grava voto anônimo")
Rel(servLocal, filaLocal, "Enfileira BU e logs")
Rel(filaLocal, gateway, "Reenvia quando houver conexão", "HTTPS")

Rel(ti, github, "Abre pull request")
Rel(github, registro, "Publica imagem assinada após testes e aprovação")
Rel(comissao, portal, "Cadastra eleição, aprova versão, apura", "HTTPS")
Rel(auditor, portal, "Confere BUs, hash e logs", "HTTPS")
Rel(auditor, github, "Revisa o código")
Rel(publico, portal, "Vê o resultado", "HTTPS")
Rel(portal, gateway, "Chama a API", "HTTPS/JSON")
Rel(gateway, svcEleicao, "Encaminha")
Rel(gateway, svcApuracao, "Encaminha")
Rel(svcEleicao, dbEleicao, "Lê/grava")
Rel(svcApuracao, dbApuracao, "Lê/grava")
Rel(gateway, filaBU, "Enfileira BU recebido")
Rel(filaBU, svcApuracao, "Queue Trigger")
Rel(svcEleicao, cadastro, "Importa eleitores aptos", "HTTPS")
Rel(svcEleicao, servLocal, "Carga do local (eleitores, candidaturas, hash esperado)", "HTTPS")
Rel(svcApuracao, logs, "Grava log encadeado")
Rel(servLocal, registro, "Baixa a imagem e confere o hash", "HTTPS")
@enduml
