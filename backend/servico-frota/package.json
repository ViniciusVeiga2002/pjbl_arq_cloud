{
  "name": "servico-frota",
  "version": "1.0.0",
  "private": true,
  "description": "Microsserviço de Frota (Azure Functions, Node.js v4) — veículos (telemetria OBD2/GPS) e projeção de entregas alimentada pelos eventos de pedidos. Banco próprio (MongoDB pjbl_frota). Vertical Slice + Clean Architecture.",
  "main": "dist/src/features/**/*Function.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run build",
    "start": "func start --port 7073",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "simular-telemetria": "tsx scripts/simular-telemetria.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.5.1",
    "@azure/storage-queue": "^12.26.0",
    "mongodb": "^6.10.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
