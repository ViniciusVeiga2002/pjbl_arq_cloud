{
  "name": "servico-pedidos",
  "version": "2.0.0",
  "private": true,
  "description": "Microsserviço de Pedidos (Azure Functions, Node.js v4) — CRUD de pedidos com banco próprio (MongoDB pjbl_pedidos) e publicação de eventos na fila pedidos-eventos. Vertical Slice + Clean Architecture.",
  "main": "dist/src/features/**/*Function.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run build",
    "start": "func start --port 7071",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/functions": "^4.5.1",
    "@azure/storage-queue": "^12.26.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
