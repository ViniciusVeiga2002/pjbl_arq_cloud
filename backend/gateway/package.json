{
  "name": "gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway (Azure Functions, Node.js v4): única porta de entrada pública. Roteia /api/<prefixo>/* para o BFF correspondente, com CORS restrito, rate limiting e correlation-id.",
  "main": "dist/src/features/**/*Function.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run build",
    "start": "func start --port 7070",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/functions": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
