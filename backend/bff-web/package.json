{
  "name": "bff-web",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Frontend do dashboard web (Azure Functions, Node.js v4). Compõe os microsserviços de pedidos e de frota no formato que os microfrontends precisam. Não tem banco de dados.",
  "main": "dist/src/features/**/*Function.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run build",
    "start": "func start --port 7072",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/functions": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
